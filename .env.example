# ---------- WhatsApp Cloud API (Meta) ----------
# Token de acesso (use um token permanente de System User em produção)
WHATSAPP_TOKEN=
# ID do número de telefone (Phone Number ID), não é o número em si
WHATSAPP_PHONE_NUMBER_ID=
# Texto inventado por você; tem de ser igual ao que colocar no painel da Meta
WEBHOOK_VERIFY_TOKEN=troque-por-um-texto-secreto
# App Secret da app Meta (Configurações > Básico). Valida que o webhook vem mesmo da Meta
META_APP_SECRET=
GRAPH_API_VERSION=v25.0

# ---------- IA (Google Gemini) ----------
GEMINI_API_KEY=
# Confirme o modelo Flash estável atual em https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# ---------- Base de dados (Postgres) ----------
DATABASE_URL=postgres://user:senha@host:5432/banco
# Coloque "true" se o provedor exigir SSL (Render externo, Supabase, Neon)
DATABASE_SSL=false

# ---------- Comportamento ----------
BOT_NAME=Meu Assistente
DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Lisbon
# Números autorizados, só dígitos com código do país, separados por vírgula.
# Enquanto for uso pessoal, coloque o seu. Deixe vazio para aceitar qualquer pessoa.
ALLOWED_NUMBERS=351900000000
PORT=3000

# ID da conta WhatsApp Business ("Messaging account ID" no painel). Com ele, o servidor
# associa a conta à app no arranque, para a Meta entregar as mensagens ao webhook.
WHATSAPP_BUSINESS_ACCOUNT_ID=
